{
  "name": "dsh-siyuan-export",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Export a single dsh assistant reply to SiYuan as a structured note.",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client/handoff.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run build:host && npm run build:client",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pack": "npm pack",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.2-rc.1 <0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "file:../github/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-host-webserver": "file:../github/deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-session": "file:../github/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-client-locale": "file:../github/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-agent": "file:../github/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-client-ui-slots": "file:../github/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-renderer": "file:../github/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-chat": "file:../github/deepseek-harness/packages/client/ui-chat",
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
